# =============================================================================
# Flask Engine - Environment Variables (CONTOH / TEMPLATE)
# Salin file ini menjadi .env lalu isi nilai yang sesuai.
#   cp .env.example .env
# =============================================================================

# API key untuk melindungi endpoint Flask dari akses tidak sah.
# Generate key kuat: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_API_KEY=your-strong-api-key-here

# Port dan host Flask server.
# TODO: Sesuaikan FLASK_HOST jika Flask perlu diakses dari network lain.
FLASK_PORT=5050
FLASK_HOST=127.0.0.1

# (Opsional) Path ke file JSON penyimpanan encoding wajah untuk development.
# Kosongkan untuk menggunakan default: python_engine/face_encodings.json
# ENCODINGS_FILE=./face_encodings.json

# Koneksi database MySQL (untuk legacy endpoints)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_buku_tamu
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# Simulasi Remote Server Production (REST API / Web Services)
# Isi nilai-nilai ini setelah akses server diberikan pembimbing.
# ==============================================================================

# Flag simulasi: set ke 'false' setelah akses server asli diterima
USE_SIMULATION=true

# Identitas aplikasi yang didaftarkan ke instansi
REMOTE_APP_ID=your-app-id-from-instansi
REMOTE_APP_SECRET=your-app-secret-from-instansi

# API Key dari instansi
REMOTE_API_KEY=your-api-key-from-instansi

# Base URL server production
# Contoh: https://api.[nama-server].go.id/v1
REMOTE_BASE_URL=https://api.[nama-server].go.id/v1

# Timeout request ke server production (detik)
REMOTE_TIMEOUT=30

# Versi API
REMOTE_API_VERSION=v1

# Environment: sandbox | production
REMOTE_ENV=sandbox

# Koneksi database production server (isi setelah dapat kredensial)
# REMOTE_DB_HOST=
# REMOTE_DB_PORT=3306
# REMOTE_DB_NAME=
# REMOTE_DB_USER=
# REMOTE_DB_PASS=

